  "version": "1.0.0",
  "type": "module",
  "description": "Node.js backend for DiagnoScope medical imaging platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "drizzle-kit push",
